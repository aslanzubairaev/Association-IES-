# Recipient email for final help requests
HELP_RECIPIENT_EMAIL=msouleymanov@gmail.com

# SMTP settings (required for /api/help/submit)
HELP_SMTP_HOST=smtp.gmail.com
HELP_SMTP_PORT=587
HELP_SMTP_SECURE=false
HELP_SMTP_USER=your-smtp-user@gmail.com
HELP_SMTP_PASS=your-app-password
HELP_FROM_EMAIL=Association IES <your-smtp-user@gmail.com>

# OpenAI settings (used by /api/help/classify and /api/help/next-question)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=12000

# Upload limits for administrative documents
HELP_MAX_FILES=5
HELP_MAX_FILE_SIZE_MB=7
HELP_MAX_TOTAL_FILES_SIZE_MB=20
HELP_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif

# Basic anti-spam throttling
HELP_CLASSIFY_RATE_MAX=12
HELP_CLASSIFY_RATE_WINDOW_MS=60000
HELP_SUBMIT_RATE_MAX=4
HELP_SUBMIT_RATE_WINDOW_MS=60000

# Sanity CMS (for activities CRUD + detail pages)
NEXT_PUBLIC_SANITY_PROJECT_ID=yourProjectId
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-01
